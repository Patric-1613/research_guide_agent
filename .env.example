OPENAI_API_KEY=sk-...
# Optional: unauthenticated Semantic Scholar calls work at a low rate limit.
# Add a free key from https://www.semanticscholar.org/product/api to raise it.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: required for the Unpaywall half of abstract recovery
# (research_agent/enrichment.py). Unpaywall's terms require a real, working
# contact email on every request and rejects placeholder addresses — without
# this set, that source is skipped and enrichment falls through to CrossRef
# only. See https://unpaywall.org/products/api
UNPAYWALL_EMAIL=
# Optional: enables the web-context section (research_agent/web_search.py).
# Get a free key at https://tavily.com. Without this set, search degrades to
# paper-only results.
TAVILY_API_KEY=
# Optional: enables Langfuse tracing (research_agent/tracing.py and the
# @observe-decorated functions across dedup.py, ingestion.py, embeddings.py,
# query_expansion.py, qa.py, summarize.py, plus agent.py's LangChain
# CallbackHandler). Get free keys at https://cloud.langfuse.com. Without
# these set, the Langfuse client falls back to a disabled/no-op state —
# tracing is skipped, not an error, so the app still runs fine without them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# FRONTEND_ORIGIN: the ONE browser origin the backend emits credentialed
# CORS headers for (research_agent/config/settings.py's get_cors_config(),
# validated once at startup — an invalid value refuses to boot).
#   - unset + APP_ENV=local:      http://localhost:5173 and
#                                 http://127.0.0.1:5173 are allowed (the
#                                 Vite dev-server default). Unchanged.
#   - unset + APP_ENV=production:  NO cross-origin is allowed. This is
#                                 correct for a same-origin production
#                                 deployment (the built frontend served by
#                                 this same process). A SPLIT-origin
#                                 production deployment MUST set this.
#   - set:                        exactly that one origin. Must be an
#                                 origin only — scheme (http/https) + host
#                                 [+ port], no path/query/fragment, no
#                                 embedded credentials, no "*". A lone
#                                 trailing "/" is normalized away. In
#                                 production a localhost/127.0.0.1 value is
#                                 refused (no silent dev origin in prod).
# Example split-origin production value: https://research.example.com
FRONTEND_ORIGIN=
# Optional: contact email sent on OpenAlex API calls when a curation
# session's optional OpenAlex fallback is used (CurationStartRequest.
# use_openalex_fallback, off by default — research_agent/query_expansion.py).
# OpenAlex's polite pool wants a real contact email on every request; without
# this set, the fallback still works but without the higher polite-pool rate
# limit.
OPENALEX_MAILTO=
# PR2B: single-user HTTP Basic Auth access gate (research_agent/
# auth_middleware.py, validated at startup by research_agent/config/
# settings.py's get_auth_config()). All four unset (the default) is the
# current, unauthenticated local-dev/test behavior -- unchanged.
#
# APP_ENV: "local" (default) or "production". Set to "production" for
# any real deployment -- see below for what that requires.
APP_ENV=
# AUTH_ENABLED: "true"/"1" or "false"/"0" (default false). Required to
# be "true" whenever APP_ENV=production -- app construction raises and
# refuses to start otherwise. There is no production auth-disable
# override; a broken gate is fixed by restoring a previous known-good
# image/commit, never by turning auth off.
AUTH_ENABLED=
# AUTH_USERNAME / AUTH_PASSWORD: required, non-empty when AUTH_ENABLED
# is true (in either APP_ENV). AUTH_PASSWORD must additionally be at
# least 16 characters -- generate it with a password manager or your
# platform's own secret generator, not typed by hand. Provide both only
# via platform secrets; never commit real values here, never place them
# in frontend code, a URL, or a query parameter.
AUTH_USERNAME=
AUTH_PASSWORD=
# Day 2 (public multi-user deployment foundation, see
# docs/plans/public-multi-user-deployment-review.md): the production
# PostgreSQL ownership store (research_agent/config/settings.py's
# get_database_config(), validated once at startup).
#
# DATABASE_URL: unset + APP_ENV=local (the default) -- local development
# and the existing test suite stay SQLite-only, exactly as today. Unset +
# APP_ENV=production always refuses to start -- there is no production
# fallback to SQLite. Set (either APP_ENV): a full postgresql:// or
# postgresql+psycopg:// connection string, e.g.
# postgresql://<user>:<password>@<host>:<port>/<database> -- compatible
# with the Cloud SQL Auth Proxy's own localhost-style connection target.
# Never commit a real value here; provide it only via a real secret store
# in any shared/deployed environment. The configured value is never
# logged in full -- only a password-redacted form
# (scheme://user:***@host:port/db) ever appears in any log line.
DATABASE_URL=
# DATABASE_POOL_MIN_SIZE / DATABASE_POOL_MAX_SIZE: optional, strict
# positive integers, default 1/5. Deliberately small -- this app's
# routes are synchronous and already bounded by ANYIO_THREAD_LIMIT above,
# and a small explicit pool is what stays compatible with Cloud SQL Auth
# Proxy and a small-tier Cloud SQL instance's own connection ceiling
# later. DATABASE_POOL_MAX_SIZE may not exceed 20; DATABASE_POOL_MIN_SIZE
# may not exceed DATABASE_POOL_MAX_SIZE -- either violation refuses to
# start rather than silently clamping.
DATABASE_POOL_MIN_SIZE=
DATABASE_POOL_MAX_SIZE=
