# Frontend environment. Copy to `.env` for local development.
# Every value here is PUBLIC (it ships in the browser bundle). Never put a
# secret, service-account JSON, private key, or backend credential here.

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL: the backend's base URL.
#   - unset: http://localhost:8000 in dev, same-origin in a production build.
#   - set: used verbatim (trailing slashes stripped).
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# VITE_AUTH_MODE: "disabled" | "basic" | "firebase".
# MUST match the backend's AUTH_MODE (research_agent/config/settings.py):
#   - "disabled" (default when unset): no sign-in. Matches backend
#     AUTH_MODE=disabled / AUTH_ENABLED unset. Local development default.
#   - "basic": no sign-in UI; the browser replays HTTP Basic-Auth
#     credentials itself. Matches backend AUTH_MODE=basic (or the legacy
#     AUTH_ENABLED=true).
#   - "firebase": Google sign-in required; the app calls GET /me and shows
#     an "awaiting approval" screen until the account is approved. Matches
#     backend AUTH_MODE=firebase. The VITE_FIREBASE_* values below are then
#     REQUIRED -- the app fails loudly at startup if any is missing.
VITE_AUTH_MODE=

# ---------------------------------------------------------------------------
# Firebase public web config -- REQUIRED only when VITE_AUTH_MODE=firebase.
# Copy these from the Firebase console: Project settings > General > "Your
# apps" > the Web app's config object. They are public client-side values,
# NOT secrets.
#
# VITE_FIREBASE_PROJECT_ID MUST equal the backend's FIREBASE_PROJECT_ID; a
# mismatch makes every ID token be rejected (a loud, immediate 401, not a
# silent failure).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional -- only needed if you later add Firebase features beyond auth.
VITE_FIREBASE_APP_ID=
