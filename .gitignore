.DS_Store
# Raw human-maintained reference spreadsheet: binary, not diff-friendly.
# eval_data/reference_topics.json (its converted, reviewable output) is
# tracked instead.
eval_data/reference_topics.xlsx
# Ad hoc local backup of frontend/ (including node_modules) — not a build
# artifact, not referenced by anything in the repo. Recommended for removal
# entirely; ignored here in the meantime so it can't be committed by
# accident. See specs/remaining-standardization-plan.md.
frontend.zip
# scripts/ragas_eval.py's per-run detail artifacts (run_<id>.json +
# raw_<timestamp>.jsonl) — growing without bound, reviewed locally, not
# meant to accumulate in git history the way eval_results/history.csv's
# one-row-per-run log does. See docs/evaluation.md.
eval_results/runs/
# R6D.4b: real R4-generated draft/refined pair capture artifacts
# (unlabelled r6d4-capture-v1 JSON files, `research_agent.evals.cli
# capture-refinement`'s own output) — a temporary, local working area,
# never auto-tracked, separate from eval_data/report_refinement/'s
# tracked synthetic fixtures. See docs/evaluation.md's "R6D.4b" section.
eval_results/captures/
